# ---------------------------------------------------------------------------
# VEYRA — Android release imza bilgileri (ŞABLON)
# ---------------------------------------------------------------------------
# Kullanım:
#   cp keystore.properties.example keystore.properties
#   ve değerleri scripts/android/make-keystore.sh çıktısıyla doldurun.
#
# GÜVENLİK: keystore.properties ve *.keystore dosyaları .gitignore içindedir,
# Git'e ASLA girmemelidir. CI için aynı değerleri GitHub Secrets olarak tanımlayın:
#   VEYRA_KEYSTORE_PATH / VEYRA_KEYSTORE_PASSWORD / VEYRA_KEY_ALIAS / VEYRA_KEY_PASSWORD
#
# storeFile yolu bu dizine (android/) görelidir veya mutlak yazılabilir.
storeFile=veyra-release.keystore
storePassword=CHANGE_ME
keyAlias=veyra-release
keyPassword=CHANGE_ME
