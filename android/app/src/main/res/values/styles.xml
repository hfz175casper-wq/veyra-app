    <!--
      A??l?? temas?.
      - android:background        ? Android 12 ?ncesi sistem splash'i (splash.png)
      - windowSplashScreen*       ? Android 12+ sistem splash'i (koyu zemin + VEYRA rozeti)
      - postSplashScreenTheme     ? splash sonras? temaya yumu?ak ge?i?
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/veyraNight</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/veyraNight</item>
        <item name="android:navigationBarColor">@color/veyraNight</item>
    </style>
</resources>
